# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
.env.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# NERV tracking (fuera del repo público)
engram/

# NERV agent worktrees (temporales)
.claude/worktrees/

# Entregas de diseño sin aplicar (el bundle del reskin y su descompresión).
# NO son código del proyecto: son una copia vieja de pantallas que ya evolucionaron.
# Ojo: ignorarlas acá NO alcanza para que tsc no las mire — eso lo resuelve el
# "exclude" del tsconfig.json.
assets/*.zip
assets/impl/

# Cachés de los scripts de build
__pycache__/

# Credenciales de publicación. **La regla va ANTES de bajar el archivo, no después.**
# La clave de servicio de Google Play firma subidas a la tienda en nombre de la
# cuenta: filtrarla es entregar la capacidad de publicar. Y un secreto que entró
# al historial no se saca con un `rm` — hay que reescribir el historial y rotar
# la clave, que es lo que ya se pagó una vez con `.env`.
play-service-account.json
*-service-account.json
google-service-account*.json
/credentials.json
